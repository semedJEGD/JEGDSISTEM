generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  SUPERADMIN
  COMITE
  ESCOLA
}

enum SexoAtleta {
  MASCULINO
  FEMININO
}

enum DocumentoTipo {
  RG
  CERTIDAO
  SEM_DOCUMENTO
}

enum CategoriaEtaria {
  MIRIM     // 9 a 11 anos
  INFANTIL  // 12 a 14 anos
  INFANTO   // 15 a 17 anos
  JUNIOR    // 18 a 20 anos
}

enum StatusInscricao {
  PENDENTE
  VALIDADA
  REJEITADA
}

model Municipio {
  id                String             @id @default(uuid())
  nome              String
  sigla             String?
  uf                String             @default("MA")
  slug              String             @unique
  nomeEvento        String             // ex: "Jogos Escolares de Gonçalves Dias"
  siglaEvento       String             // ex: "JEGDS"
  logoUrl           String?
  brasaoUrl         String?
  contatoSemed      String?
  ativo             Boolean            @default(true)
  escolas           Escola[]
  usuarios          Usuario[]
  atletas           Atleta[]
  modalidades       Modalidade[]
  inscricoes        Inscricao[]
  comunicados       Comunicado[]
  registrosControle RegistroControle[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Escola {
  id                  String       @id @default(uuid())
  municipioId         String?
  municipio           Municipio?   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  nome                String
  sigla               String?
  inep                String?
  endereco            String
  bairro              String?
  responsavelNome     String
  responsavelTelefone String
  loginEmail          String       @unique
  senhaHash           String
  usuarios            Usuario[]
  atletas             Atleta[]
  inscricoes          Inscricao[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([municipioId])
}

model Usuario {
  id          String       @id @default(uuid())
  municipioId String?
  municipio   Municipio?   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  nome        String
  email       String       @unique
  cpf         String?
  senhaHash   String
  papel       PapelUsuario @default(ESCOLA)
  escolaId    String?
  escola      Escola?      @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([municipioId])
}

enum TipoRegistroControle {
  ELEGIBILIDADE
  AGUA
  LANCHE
  TRANSPORTE_IDA
  TRANSPORTE_VOLTA
  CREDENCIAMENTO
}

model Atleta {
  id                       String             @id @default(uuid())
  municipioId              String?
  municipio                Municipio?         @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  nomeCompleto             String
  dataNascimento           DateTime
  sexo                     SexoAtleta
  semDocumento             Boolean            @default(false)
  documentoTipo            DocumentoTipo      @default(RG)
  documentoNumero          String
  documentoUrl             String?
  fotoUrl                  String?
  crachaToken              String?            @unique
  escolaId                 String
  escola                   Escola             @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  categoria                CategoriaEtaria
  consentimentoResponsavel Boolean            @default(true)
  matricula                String?
  turma                    String?
  tipoSanguineo            String?
  inscricoes               Inscricao[]
  registrosControle        RegistroControle[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([municipioId])
  @@index([escolaId])
}

model RegistroControle {
  id            String               @id @default(uuid())
  municipioId   String?
  municipio     Municipio?           @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  atletaId      String
  atleta        Atleta               @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  tipo          TipoRegistroControle
  timestamp     DateTime             @default(now())
  registradoPor String
  papelOperador String?
  escolaId      String?
  detalhes      String?
  createdAt     DateTime             @default(now())

  @@index([municipioId])
  @@index([atletaId])
  @@index([tipo])
}

model Modalidade {
  id                 String       @id @default(uuid())
  municipioId        String?
  municipio          Municipio?   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  codigo             String
  nome               String
  tipo               String       @default("COLETIVA") // COLETIVA | INDIVIDUAL
  dataEvento         DateTime
  prazoInscricao     DateTime
  minAtletas         Int          @default(1)
  maxAtletas         Int          @default(12)
  maxProvasPorAtleta Int          @default(1)
  provasDisponiveis  String[]     @default([])
  descricao          String?
  inscricoes         Inscricao[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([municipioId, codigo])
}

model Inscricao {
  id             String          @id @default(uuid())
  municipioId    String?
  municipio      Municipio?      @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  atletaId       String
  atleta         Atleta          @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  modalidadeId   String
  modalidade     Modalidade      @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  escolaId       String
  escola         Escola          @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  categoria      CategoriaEtaria
  sexo           SexoAtleta
  prova          String?         // Usado em Atletismo (ex: "100m", "salto")
  equipe         String?         // Nome ou identificador de grupo para esportes coletivos
  status         StatusInscricao @default(PENDENTE)
  motivoRejeicao String?
  dataInscricao  DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([atletaId, modalidadeId, prova])
  @@index([municipioId])
  @@index([escolaId])
}

model Comunicado {
  id             String     @id @default(uuid())
  municipioId    String?
  municipio      Municipio? @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  titulo         String
  conteudo       String
  categoria      String     @default("CRONOGRAMA")
  urgente        Boolean    @default(false)
  autor          String     @default("Comitê Organizador")
  dataPublicacao DateTime   @default(now())

  @@index([municipioId])
}

// ============================================================
// MÓDULO EVENTOS DO DIA, PORTAL DE NOTÍCIAS & MODO TELÃO
// ============================================================

model NoticiaEvento {
  id                String   @id @default(uuid())
  municipioId       String?
  titulo            String
  resumo            String
  conteudo          String?
  modalidadeNome    String?
  categoria         String?
  horarioOcorrencia String?  // ex: "08:30 • Manhã"
  local             String?
  imagemUrl         String?
  destaqueTelao     Boolean  @default(true)
  publicado         Boolean  @default(true)
  autor             String   @default("Coordenação SEMED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([municipioId])
}

model CronogramaItem {
  id              String   @id @default(uuid())
  municipioId     String?
  titulo          String
  descricao       String?
  etapa           String   @default("1ª Etapa")
  modalidadeNome  String?
  categoria       String?
  local           String?
  dataEvento      String   // YYYY-MM-DD
  horarioInicio   String   // HH:mm
  horarioFim      String?  // HH:mm
  status          String   @default("PREVISTO") // PREVISTO | EM_ANDAMENTO | CONCLUIDO
  resumoResultado String?
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([municipioId])
  @@index([dataEvento])
}

model PartidaEvento {
  id               String   @id @default(uuid())
  municipioId      String?
  numeroJogo       Int?
  modalidadeCodigo String
  modalidadeNome   String
  categoria        String   // MIRIM | INFANTIL | INFANTO | JUNIOR
  sexo             String   // MASCULINO | FEMININO
  fase             String   @default("GRUPOS") // GRUPOS | OITAVAS | QUARTAS | SEMIFINAL | TERCEIRO_LUGAR | FINAL
  grupo            String?  // ex: "Grupo A"
  dataEvento       String   // YYYY-MM-DD
  horario          String   // HH:mm
  local            String?  // ex: "Quadra 01 — Aldenora Araújo"
  escolaAId        String
  escolaANome      String
  escolaASigla     String?
  escolaBId        String
  escolaBNome      String
  escolaBSigla     String?
  placarA          Int      @default(0)
  placarB          Int      @default(0)
  detalhesPlacar   String?  // ex: "25x21, 25x18" ou "Prorr. 2x1"
  status           String   @default("AGENDADO") // AGENDADO | AO_VIVO | ENCERRADO | WO
  woEscolaId       String?
  vencedorEscolaId String?
  observacao       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([municipioId])
  @@index([modalidadeCodigo])
  @@index([status])
}

model ArtilhariaEvento {
  id               String   @id @default(uuid())
  municipioId      String?
  atletaId         String?
  atletaNome       String
  fotoUrl          String?
  escolaId         String
  escolaNome       String
  escolaSigla      String?
  modalidadeCodigo String
  modalidadeNome   String
  categoria        String   @default("INFANTIL")
  sexo             String   @default("MASCULINO")
  gols             Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([municipioId])
  @@index([modalidadeCodigo])
}

model MedalhaEvento {
  id               String   @id @default(uuid())
  municipioId      String?
  escolaId         String
  escolaNome       String
  escolaSigla      String?
  modalidadeCodigo String
  modalidadeNome   String
  categoria        String   @default("INFANTIL")
  sexo             String   @default("MASCULINO")
  prova            String?  // ex: "100m Rasos"
  tipo             String   // OURO | PRATA | BRONZE
  atletaNome       String?
  createdAt        DateTime @default(now())

  @@index([municipioId])
  @@index([escolaId])
}

model AvisoTelao {
  id          String   @id @default(uuid())
  municipioId String?
  titulo      String
  mensagem    String
  tipo        String   @default("CHAMADA") // CHAMADA | INFORMATIVO | URGENTE
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([municipioId])
}

model ChaveamentoEvento {
  id               String   @id @default(uuid())
  municipioId      String?
  modalidadeCodigo String
  modalidadeNome   String
  categoria        String   // MIRIM | INFANTIL | INFANTO | JUNIOR
  sexo             String   // MASCULINO | FEMININO
  prova            String?  // Opcional: usado no Atletismo (ex: "100m Rasos")
  formato          String   // GRUPOS_MATA_MATA | MATA_MATA | BERGER_UNICO | FINAL_DIRETA | BALIZAMENTO_ATLETISMO | SUICO_XADREZ | GRUPOS_TENIS_MESA
  seed             String
  status           String   @default("RASCUNHO") // RASCUNHO | CONGELADO
  criadoPor        String   @default("Coordenação SEMED")
  congeladoEm      DateTime?
  auditoriaJson    String?  // Snapshot JSON da auditoria pré-chaveamento
  estruturaJson    String?  // JSON de grupos, séries de atletismo ou rodadas suíças
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([municipioId])
  @@index([modalidadeCodigo, categoria, sexo])
}
